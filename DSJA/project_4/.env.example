# Copy this file to .env and replace placeholders locally.
# Do not commit personal absolute paths, tokens, cookies, or credentials.

SBS_DATASCIENCE_REPO=/path/to/SBS_dataScience
DSJA_ROOT=/path/to/SBS_dataScience/DSJA
PROJECT_4_ROOT=/path/to/SBS_dataScience/DSJA/project_4
VIRTUAL_ENV=/path/to/python/venv
PYTHONPATH=/path/to/SBS_dataScience/DSJA/project_4

MPLCONFIGDIR=/tmp/p4-matplotlib
IPYTHONDIR=/tmp/p4-ipython
JUPYTER_RUNTIME_DIR=/tmp/p4-jupyter-runtime
JUPYTER_PATH=/path/to/SBS_dataScience/DSJA/project_4/.jupyter

GALLIUM_DRIVER=d3d12
MESA_D3D12_DEFAULT_ADAPTER_NAME=NVIDIA
LD_LIBRARY_PATH=/usr/lib/wsl/lib

CHROME_BIN=/path/to/chromium
GOOGLE_CHROME_BIN=/path/to/chromium
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/path/to/chromium
SELENIUM_BROWSER_BINARY=/path/to/chromium
SBS_CHROME_BIN=/path/to/chromium
