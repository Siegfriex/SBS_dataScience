{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sbs.local/p4/semantic-ncs-reference/v4.0/candidate_packet.schema.json",
  "title": "P4 bounded candidate packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidatePacketId", "annotationTaskId", "targetTextSha256", "targetCharCount", "targetTokenCount", "sourceRole", "contextBlockCount", "retrievalTopK", "llmVisibleK", "truncationPolicyVersion", "candidateCodesJson", "packetSha256"],
  "properties": {
    "candidatePacketId": {"type": "string", "minLength": 1},
    "annotationTaskId": {"type": "string", "minLength": 1},
    "targetTextSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "targetCharCount": {"type": "integer", "minimum": 1, "maximum": 1200},
    "targetTokenCount": {"type": "integer", "minimum": 1, "maximum": 600},
    "sourceRole": {"type": "string", "enum": ["DUTY", "REQUIRED", "PREFERRED", "OTHER"]},
    "contextBlockCount": {"type": "integer", "minimum": 0, "maximum": 2},
    "retrievalTopK": {"type": "integer", "minimum": 1, "maximum": 10},
    "llmVisibleK": {"type": "integer", "minimum": 1, "maximum": 5},
    "truncationPolicyVersion": {"type": "string", "minLength": 1},
    "candidateCodesJson": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "decision": {"type": ["string", "null"], "enum": ["SELECT_CANDIDATE", "MULTI_LABEL", "NONE_OF_CANDIDATES", "OUT_OF_SCOPE", "ABSTAIN", null]},
    "packetSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
