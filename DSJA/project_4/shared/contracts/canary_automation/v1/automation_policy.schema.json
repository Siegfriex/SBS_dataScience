{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:p4:canary-automation:automation-policy:v1",
  "title": "P4 Recursive Canary Automation Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "maxAutoRepairIterationsPerTier",
    "maxCanaryRunsPerScope",
    "allowedBranchPrefixes",
    "allowedWriteRoots",
    "requiredA1HandoffArtifacts",
    "requiredA3AcceptanceArtifacts",
    "requiredA5AuditArtifacts",
    "canaryTierDefinitions",
    "approvalSchemaVersion",
    "sourcePolicySchemaVersion",
    "networkPolicy",
    "scopeEscalation",
    "budgetExhaustionPolicy",
    "tier1",
    "tier2",
    "fallback",
    "rawStorage",
    "tier3",
    "tier4"
  ],
  "properties": {
    "schemaVersion": {"const": "p4-canary-automation-v1"},
    "maxAutoRepairIterationsPerTier": {"type": "integer", "minimum": 1},
    "maxCanaryRunsPerScope": {"type": "integer", "minimum": 1},
    "allowedBranchPrefixes": {"$ref": "#/$defs/nonEmptyStringArray"},
    "allowedWriteRoots": {"$ref": "#/$defs/nonEmptyStringArray"},
    "requiredA1HandoffArtifacts": {"$ref": "#/$defs/nonEmptyStringArray"},
    "requiredA3AcceptanceArtifacts": {"$ref": "#/$defs/nonEmptyStringArray"},
    "requiredA5AuditArtifacts": {"$ref": "#/$defs/nonEmptyStringArray"},
    "canaryTierDefinitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["TIER0", "TIER1", "TIER2", "TIER3", "TIER4"],
      "properties": {
        "TIER0": {"type": "object", "minProperties": 1},
        "TIER1": {"type": "object", "minProperties": 1},
        "TIER2": {"type": "object", "minProperties": 1},
        "TIER3": {"type": "object", "minProperties": 1},
        "TIER4": {"type": "object", "minProperties": 1}
      }
    },
    "approvalSchemaVersion": {"type": "string", "minLength": 1},
    "sourcePolicySchemaVersion": {"type": "string", "minLength": 1},
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowNetworkWithoutApproval",
        "allowExternalAts",
        "allowBrowserAutomation",
        "allowFullM2Automation"
      ],
      "properties": {
        "allowNetworkWithoutApproval": {"const": false},
        "allowExternalAts": {"const": false},
        "allowBrowserAutomation": {"const": false},
        "allowFullM2Automation": {"const": false}
      }
    },
    "scopeEscalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiresNewApprovalArtifact", "requiresA5ForTier4", "requiresA5ForM2"],
      "properties": {
        "requiresNewApprovalArtifact": {"const": true},
        "requiresA5ForTier4": {"const": true},
        "requiresA5ForM2": {"const": true}
      }
    },
    "budgetExhaustionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stopAutomaticPatch", "stopScopeEscalation", "requireHumanDecision"],
      "properties": {
        "stopAutomaticPatch": {"const": true},
        "stopScopeEscalation": {"const": true},
        "requireHumanDecision": {"const": true}
      }
    },
    "tier1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionMode", "scopeEscalationMode", "requiresRequestConflictCountZero",
        "requiresCursorLoopCountZero", "requiresCheckpointResumePass",
        "requiresTerminalPageEvidenceComplete", "requiresKillSwitchPass",
        "requiresExternalAtsCallsZero", "a5BeforeRepetitionOrEscalation"
      ],
      "properties": {
        "executionMode": {"const": "INDEX_ONLY"},
        "scopeEscalationMode": {"const": "CONTROLLER_PROPOSES_USER_APPROVES"},
        "requiresRequestConflictCountZero": {"const": true},
        "requiresCursorLoopCountZero": {"const": true},
        "requiresCheckpointResumePass": {"const": true},
        "requiresTerminalPageEvidenceComplete": {"const": true},
        "requiresKillSwitchPass": {"const": true},
        "requiresExternalAtsCallsZero": {"const": true},
        "a5BeforeRepetitionOrEscalation": {"const": "CONDITIONAL"}
      }
    },
    "tier2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detailSampleSize", "sampleFrame", "samplingMethod", "samplingSeedMaterial",
        "requireSelectionManifest", "selectionManifestName", "preserveTerminalStatuses"
      ],
      "properties": {
        "detailSampleSize": {"const": 10},
        "sampleFrame": {"const": "TIER1_DISCOVERED_UNIQUE_POSTING_IDS"},
        "samplingMethod": {"const": "deterministic_random_without_replacement"},
        "samplingSeedMaterial": {
          "const": ["canaryRunId", "approvedScopeHash", "tier1ManifestSha256"]
        },
        "requireSelectionManifest": {"const": true},
        "selectionManifestName": {"const": "detail_canary_sample_manifest.json"},
        "preserveTerminalStatuses": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "contains": {"const": "PARSER_QUARANTINED"},
          "items": {"enum": ["NOT_FOUND", "EXPIRED", "RETRY_EXHAUSTED", "PARSER_QUARANTINED"]}
        }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "autoPatchLowRisk", "autoPatchMediumRisk", "autoNetworkRerunMediumRisk",
        "highRiskAction", "ambiguousAutoSelectionAllowed", "overwriteRawOrTerminalStatusAllowed"
      ],
      "properties": {
        "autoPatchLowRisk": {"const": true},
        "autoPatchMediumRisk": {"const": true},
        "autoNetworkRerunMediumRisk": {"const": false},
        "highRiskAction": {"const": "QUARANTINE_AND_USER_DECISION"},
        "ambiguousAutoSelectionAllowed": {"const": false},
        "overwriteRawOrTerminalStatusAllowed": {"const": false}
      }
    },
    "rawStorage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immutable", "contentAddressed", "gitRawBytesAllowed",
        "automatedWriteWithinApprovedScope", "automatedDeletionAllowed"
      ],
      "properties": {
        "immutable": {"const": true},
        "contentAddressed": {"const": true},
        "gitRawBytesAllowed": {"const": false},
        "automatedWriteWithinApprovedScope": {"const": true},
        "automatedDeletionAllowed": {"const": false}
      }
    },
    "tier3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linkareerHostedAssetsOnly", "allowedAssetTypes", "externalAssetHostDefaultDeny",
        "agentCanPrepareExceptionPacket", "agentCanSelfApproveExternalHost", "ocrMode",
        "acceptedNcsMappingFromOcrAllowed", "requiredOcrScenarios"
      ],
      "properties": {
        "linkareerHostedAssetsOnly": {"const": true},
        "allowedAssetTypes": {
          "const": ["poster", "thumbnail", "activitytext_embedded_image", "attachment"]
        },
        "externalAssetHostDefaultDeny": {"const": true},
        "agentCanPrepareExceptionPacket": {"const": true},
        "agentCanSelfApproveExternalHost": {"const": false},
        "ocrMode": {"const": "COLLECT_QUEUE_QUALITY_ONLY"},
        "acceptedNcsMappingFromOcrAllowed": {"const": false},
        "requiredOcrScenarios": {
          "type": "array",
          "minItems": 9,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "tier4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representativeStrata", "actualPeriodsRequireUserApproval",
        "requestBudgetRequiresUserApproval", "checkpointRestartSimulationAllowed",
        "requiresA5Audit", "scopeExpansionMode"
      ],
      "properties": {
        "representativeStrata": {"const": ["EARLY", "MIDDLE", "RECENT"]},
        "actualPeriodsRequireUserApproval": {"const": true},
        "requestBudgetRequiresUserApproval": {"const": true},
        "checkpointRestartSimulationAllowed": {"const": true},
        "requiresA5Audit": {"const": true},
        "scopeExpansionMode": {"const": "CONTROLLER_PROPOSES_USER_APPROVES"}
      }
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
