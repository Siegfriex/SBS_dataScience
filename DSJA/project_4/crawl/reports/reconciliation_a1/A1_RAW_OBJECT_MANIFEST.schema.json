{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sbs-data-science.invalid/p4/crawl/A1_RAW_OBJECT_MANIFEST.schema.json",
  "title": "P4 portable external raw object manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rawPostingId",
    "sourceMode",
    "storageRootId",
    "objectLocatorRelative",
    "compressedSha256",
    "contentSha256",
    "byteCount",
    "retrievedAtUtc",
    "sourceUrlFingerprint",
    "mountPolicyVersion",
    "availabilityStatus"
  ],
  "properties": {
    "rawPostingId": {
      "type": "string",
      "minLength": 1
    },
    "sourceMode": {
      "enum": [
        "observed-dev",
        "production"
      ]
    },
    "storageRootId": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_.-]+$"
    },
    "objectLocatorRelative": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "compressedSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contentSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "byteCount": {
      "type": "integer",
      "minimum": 1
    },
    "contentByteCount": {
      "type": "integer",
      "minimum": 1
    },
    "retrievedAtUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "sourceUrlFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mountPolicyVersion": {
      "const": "p4-raw-mount-v1"
    },
    "availabilityStatus": {
      "enum": [
        "AVAILABLE",
        "RAW_ROOT_UNMOUNTED",
        "RAW_OBJECT_MISSING",
        "COMPRESSED_SHA_MISMATCH",
        "CONTENT_SHA_MISMATCH",
        "BYTE_COUNT_MISMATCH"
      ]
    }
  },
  "$comment": "branch=agent/p4-a1-reconcile-crawl-authority-v1; baseCommit=5508fce02ba5396b5d5a55870f1f879c1f32e8e0; headCommit=92207e8fe7cc445c7426218da06b0b064f9df941; dataVersion=observed-dev-reconciliation-20260807.1; runId=A1_RECON_20260807_01; rawStorageRootId=P4_RAW_OBSERVED_20260806_01"
}
