{
  "name": "sbs-datascience-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Polyglot workspace for SBS data science, React, and Spring Boot practice.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/react-js"
  ],
  "scripts": {
    "check:env": "bash scripts/run_env_check.sh",
    "check:gpu": "bash scripts/run_gpu_check.sh",
    "setup:tensorflow-gpu": "bash scripts/configure_tensorflow_gpu.sh",
    "dev:react": "npm --workspace apps/react-js run dev",
    "build:react": "npm --workspace apps/react-js run build",
    "preview:react": "npm --workspace apps/react-js run preview",
    "dev:spring": "mvn -f apps/spring-boot/pom.xml spring-boot:run",
    "test:spring": "mvn -f apps/spring-boot/pom.xml test"
  }
}
